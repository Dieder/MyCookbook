{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated reader, contributor, or admin account record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["reader", "contributor", "admin"],
          "maxLength": 24
        },
        "contributorRequestStatus": {
          "type": "string",
          "enum": ["none", "pending", "approved", "rejected"],
          "maxLength": 24
        },
        "contributorRequestNote": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "role",
        "contributorRequestStatus",
        "contributorRequestNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChapterRecord": {
      "title": "ChapterRecord",
      "description": "Cookbook chapter or subchapter managed by admins.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "seasonNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "epigraph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "parentChapterId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$"
        },
        "sortOrder": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "seasonNote",
        "epigraph",
        "parentChapterId",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecipeRecord": {
      "title": "RecipeRecord",
      "description": "A contributor-created or AI-customized bistro recipe stored in the cookbook.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the recipe owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plateNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "season": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "prepMinutes": {
          "type": "integer"
        },
        "cookMinutes": {
          "type": "integer"
        },
        "baseServings": {
          "type": "integer"
        },
        "heroImage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250000
        },
        "figureCaption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "storyExcerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "storyParagraphs": {
          "type": "array",
          "description": "Up to 4 editorial narrative paragraphs."
        },
        "pullQuote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "pairingNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "chefAuthor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ingredients": {
          "type": "array",
          "description": "Up to 30 structured ingredients with metric and imperial quantities."
        },
        "techniques": {
          "type": "array",
          "description": "Up to 4 interactive technique clip presets."
        },
        "steps": {
          "type": "array",
          "description": "Up to 15 numbered preparation steps with optional timers and optional YouTube videoUrl links."
        },
        "sourceType": {
          "type": "string",
          "enum": ["ai-generated", "ai-customized", "contributor"],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"],
          "maxLength": 16
        },
        "parentRecipeId": {
          "type": "string",
          "maxLength": 128
        },
        "customizationNote": {
          "type": "string",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "chapterId",
        "plateNumber",
        "title",
        "subtitle",
        "region",
        "season",
        "prepMinutes",
        "cookMinutes",
        "baseServings",
        "heroImage",
        "figureCaption",
        "storyExcerpt",
        "storyParagraphs",
        "pullQuote",
        "pairingNote",
        "chefAuthor",
        "ingredients",
        "techniques",
        "steps",
        "sourceType",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookmarkRecord": {
      "title": "BookmarkRecord",
      "description": "User-saved bookmark, preferred person count, and kitchen margin note for a recipe.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isFavorite": {
          "type": "boolean"
        },
        "servings": {
          "type": "integer"
        },
        "kitchenNote": {
          "type": "string",
          "maxLength": 1200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "recipeId",
        "isFavorite",
        "servings",
        "kitchenNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecipeRatingRecord": {
      "title": "RecipeRatingRecord",
      "description": "Reader star rating and optional single-line note for a recipe.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "recipeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rating": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "authorName",
        "recipeId",
        "rating",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "MealCalendarEntry": {
      "title": "MealCalendarEntry",
      "description": "A recipe scheduled onto a specific calendar date and meal slot for a signed-in user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "recipeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipeTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "courseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mealSlot": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"],
          "maxLength": 16
        },
        "servings": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "date",
        "recipeId",
        "recipeTitle",
        "courseId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Authenticated user profiles and RBAC roles (reader, contributor, admin)."
    },
    "/chapters/{chapterId}": {
      "schema": {
        "$ref": "#/entities/ChapterRecord"
      },
      "description": "Cookbook chapters managed via admin CRUD operations."
    },
    "/recipes/{recipeId}": {
      "schema": {
        "$ref": "#/entities/RecipeRecord"
      },
      "description": "Recipes publicly readable when published, readable by owner/admin when unpublished (draft), authored/updated by contributors or admins, and deletable only when unpublished."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": {
        "$ref": "#/entities/BookmarkRecord"
      },
      "description": "Per-user recipe bookmarks, person counts, and margin notes scoped strictly to ownerId."
    },
    "/recipeRatings/{ratingId}": {
      "schema": {
        "$ref": "#/entities/RecipeRatingRecord"
      },
      "description": "Recipe ratings and quoted one-liner notes submitted by signed-in users."
    },
    "/mealCalendar/{entryId}": {
      "schema": {
        "$ref": "#/entities/MealCalendarEntry"
      },
      "description": "Per-user scheduled recipes mapped to calendar dates (YYYY-MM-DD)."
    }
  }
}
